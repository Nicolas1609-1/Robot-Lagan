    "benchmark": "node benchmark.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "@playwright/test": "1.58.2"
  }
}
